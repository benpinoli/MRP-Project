{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "methodology_version",
    "updated_at",
    "author",
    "context",
    "measures",
    "models",
    "figures",
    "decisions",
    "change_log"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "methodology_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "author": {
      "type": "string"
    },
    "context": {
      "type": "object",
      "required": [
        "purpose",
        "dataset_ids",
        "source_registry",
        "configuration",
        "identity",
        "frequency",
        "calendar",
        "sample",
        "eligibility",
        "carried_and_stale",
        "corporate_actions",
        "availability",
        "windows",
        "validation",
        "limitations"
      ]
    },
    "measures": {
      "type": "array",
      "minItems": 4,
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/entry"
          },
          {
            "required": [
              "formula",
              "symbols",
              "unit",
              "sign_convention",
              "inputs",
              "example",
              "limitations"
            ],
            "properties": {
              "formula": {
                "type": "string"
              },
              "inputs": {
                "type": "array",
                "minItems": 1
              },
              "limitations": {
                "type": "array"
              }
            }
          }
        ]
      }
    },
    "models": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "#/$defs/entry" },
          { "required": ["formula", "outcome", "unit", "sample", "timing", "inference", "configuration", "limitations"] }
        ]
      }
    },
    "figures": {
      "type": "array",
      "minItems": 2,
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/entry"
          },
          {
            "required": [
              "series",
              "specification",
              "output_ids"
            ],
            "properties": {
              "series": {
                "type": "array",
                "minItems": 1
              },
              "specification": {
                "type": "string"
              },
              "output_ids": {
                "type": "array",
                "minItems": 0
              }
            }
          }
        ]
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "owner",
          "status",
          "decision"
        ]
      }
    },
    "change_log": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "version",
          "previous_version",
          "date",
          "reason",
          "initiating_decision",
          "affected_experiments",
          "prior_outputs_need_rerun"
        ]
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": [
        "id",
        "name",
        "version",
        "status",
        "author",
        "hypothesis_ids",
        "implementation_ref"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "status": {
          "enum": [
            "implemented",
            "executed",
            "provisional",
            "deferred"
          ]
        },
        "author": {
          "type": "string"
        },
        "hypothesis_ids": {
          "type": "array",
          "items": {
            "enum": [
              "H0",
              "H1",
              "H2",
              "H3",
              "H4",
              "H5",
              "H6",
              "H7"
            ]
          }
        },
        "implementation_ref": {
          "type": "string"
        }
      }
    }
  }
}
